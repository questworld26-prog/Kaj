# ==============================================================================
# Kaj (কাজ) - Environment Configuration Template
# Copy this file to `.env` in the root of the project:
#   cp .env.example .env
# ==============================================================================

# Database Path (Standardized across Daemon, Backup Engine, MCP Stdio & Recovery CLI)
# Keep this on local disk to prevent cloud sync WAL locking issues.
KAJ_DB_PATH="~/.local/share/kaj/tasks.db"

# Encrypted Daily Backup Configuration
# Path to your designated backup folder inside Google Drive (strictly isolated)
KAJ_BACKUP_DIR="~/Library/CloudStorage/GoogleDrive-user@example.com/My Drive/KajBackups"

# Encryption passphrase for daily database backups
# (Alternatively, store passphrase securely in ~/.config/kaj/backup.key)
KAJ_BACKUP_KEY="your-strong-passphrase-here"

# Server Configuration (Optional - Defaults shown)
# PORT=4820
# HOST=0.0.0.0
# KAJ_HOST_NAME="jarvis.local"
# KAJ_DONE_RETENTION_DAYS=90   # Auto-purge done tasks older than N days after telemetry snapshot (0 disables)

# Telegram Bot Integration (Optional)
# KAJ_TELEGRAM_ENABLED=false
# KAJ_TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# KAJ_TELEGRAM_ALLOWED_USER_IDS="123456789,987654321"
# KAJ_TELEGRAM_USER_NAMES='{"123456789":{"name":"Alice","vip":true,"notifications":["task_completed","task_triaged"]},"987654321":{"name":"Bob","notifications":["task_completed","daily_digest","backup_status"]}}'
# Notification keys (`NOTIF-003`): task_completed, task_triaged, daily_digest, backup_status (omit `notifications` for VIP/non-VIP defaults; `[]` mutes all)
# KAJ_TELEGRAM_VIP_USERS=""
# KAJ_TELEGRAM_DEFAULT_STATUS="triage"
# KAJ_TELEGRAM_POLL_INTERVAL_MS=2000
# KAJ_TELEGRAM_NOTIFY_COMPLETION=true
# KAJ_TELEGRAM_DAILY_DIGEST_ENABLED=false
# KAJ_TELEGRAM_DAILY_DIGEST_TIME="08:00"
# KAJ_TELEGRAM_DAILY_DIGEST_MAX_ITEMS=15
# KAJ_TELEGRAM_DAILY_DIGEST_SKIP_EMPTY=true
